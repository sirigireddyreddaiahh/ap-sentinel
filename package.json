{
  "name": "ap-sentinel",
  "version": "0.1.0",
  "description": "AP Sentinel: invoice fraud and duplicate checks for SAP BTP (starter)",
  "main": "index.js",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "test": "node --test test/rules.test.js test/csv.test.js test/qr.test.js",
    "smoke": "python3 test/api_smoke.py",
    "batch": "node scripts/batch-check.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@cap-js/sqlite": "^3.1.2",
    "@napi-rs/canvas": "^1.1.0",
    "@sap/cds": "^10.2.2",
    "@sap/xssec": "^4",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite"
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "reviewer": {
              "password": "reviewer",
              "roles": [
                "APClerk",
                "APController",
                "Auditor"
              ]
            },
            "clerk": {
              "password": "clerk",
              "roles": [
                "APClerk"
              ]
            },
            "controller": {
              "password": "controller",
              "roles": [
                "APController"
              ]
            },
            "auditor": {
              "password": "auditor",
              "roles": [
                "Auditor"
              ]
            }
          }
        }
      }
    },
    "server": {
      "body_parser": {
        "limit": "10mb"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
