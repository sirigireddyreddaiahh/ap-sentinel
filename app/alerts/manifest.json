{
  "_version": "1.65.0",
  "sap.app": {
    "id": "ap.sentinel.alerts",
    "type": "application",
    "title": "AP Sentinel review queue",
    "description": "Holds and flags raised by the invoice checks, with reviewer decisions.",
    "applicationVersion": { "version": "0.1.0" },
    "dataSources": {
      "mainService": { "uri": "/fraud/", "type": "OData", "settings": { "odataVersion": "4.0" } }
    }
  },
  "sap.ui5": {
    "dependencies": { "minUI5Version": "1.120.0", "libs": { "sap.fe.templates": {} } },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "AlertsList", "target": "AlertsList" },
        { "pattern": "Alerts({key}):?query:", "name": "AlertsDetails", "target": "AlertsDetails" }
      ],
      "targets": {
        "AlertsList": {
          "type": "Component", "id": "AlertsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": {
            "contextPath": "/Alerts", "variantManagement": "Page",
            "navigation": { "Alerts": { "detailPage": "AlertsDetails" } }
          } }
        },
        "AlertsDetails": {
          "type": "Component", "id": "AlertsDetails", "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/Alerts" } }
        }
      }
    }
  },
  "sap.fiori": { "archeType": "transactional" },
  "sap.ui": { "technology": "UI5", "fullWidth": true }
}
